# Desarrollo: sin DATABASE_URL se usa memoria; producción exige PostgreSQL.
NODE_ENV=development
PORT=5002
# Ejemplo para compose.yaml. Solo credenciales locales de desarrollo.
# DATABASE_URL=postgresql://organizador:local-development-only@localhost:5432/organizador
# DB_SSL=false
# Con PostgreSQL remoto externo usar TLS verificado:
# DB_SSL=true
# DB_SSL_CA_FILE=/ruta/al/certificado-ca.pem
JWT_SECRET=
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000
APP_TIME_ZONE=America/Mexico_City
# Gmail SMTP: configurar una NUEVA contraseña de aplicación en privado.
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
# Alternativa HTTPS con dominio remitente verificado en Resend.
# RESEND_API_KEY=
